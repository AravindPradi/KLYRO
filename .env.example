# ── KLYRO Studio OS ────────────────────────────────────────────────
# Copy to .env and load it with your process manager / `node --env-file=.env`.
# Every value is optional; the system runs fully offline with sensible defaults.

# REQUIRED BEFORE DEPLOYING: private Studio dashboard passphrase.
# In development, the demo passphrase is "klyro-studio".
STUDIO_PASSPHRASE=change-me-to-something-long

# Private cookie signing key (keeps sessions valid across restarts).
KLYRO_SESSION_SECRET=

# Set to "true" when serving over HTTPS behind a proxy (enables Secure cookies).
KLYRO_SECURE_COOKIES=true

# New enquiry + approval alerts. Works with Slack, Discord, Zapier, Make, n8n.
STUDIO_WEBHOOK_URL=

# Where the JSON database lives (default: ./data/klyro.json).
KLYRO_DATA_FILE=

# API port (default 8787). Vite proxies /api here in development.
PORT=8787

# ── Optional LLM refinement ────────────────────────────────────────
# Without these the local, offline brief engine is used. With them, a
# compatible chat-completions endpoint refines brief narratives only.
KLYRO_AI_BASE_URL=
KLYRO_AI_API_KEY=
KLYRO_AI_MODEL=
